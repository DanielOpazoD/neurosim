{
  "name": "neurosono-sim",
  "version": "0.1.0",
  "private": true,
  "description": "Simulador educativo de neurosonología en el navegador: vaina del nervio óptico (DVNO/ONSD) y Doppler transcraneal de la ACM. Imagen emergente de un modelo físico y fisiológico. Uso docente; no es un dispositivo médico.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "golden:update": "GOLDEN_UPDATE=1 vitest run tests/validation/golden.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "evidence": "node scripts/evidence.mjs",
    "docs:index": "node scripts/docs-index.mjs",
    "provenance:check": "node scripts/provenance-check.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run provenance:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.12.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "lint-staged": {
    "*.{ts,js,json,md,html,css}": "prettier --write",
    "*.ts": "eslint --fix"
  },
  "dependencies": {
    "three": "0.186.0"
  }
}
